{
  "name": "stargate",
  "version": "0.1.9",
  "description": "Clip web pages with a multi-tab browser, AI analysis templates, and content capture.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "bun test ./tests/*.test.ts",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "web-clipper",
    "ai"
  ],
  "author": "starhunter",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.18.121",
    "electron": "^23.3.13",
    "esbuild": "0.14.47",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
